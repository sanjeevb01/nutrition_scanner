import 'dart:io';

import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

import 'models/nutrition_result.dart';
import 'services/nutrition_service.dart';

void main() {
  runApp(const NutritionScannerApp());
}

class NutritionScannerApp extends StatelessWidget {
  const NutritionScannerApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Nutrition Scanner',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.green),
        useMaterial3: true,
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final ImagePicker _picker = ImagePicker();
  final NutritionService _nutritionService = NutritionService();

  File? _imageFile;
  bool _isLoading = false;
  List<String> _suggestedFoods = const [];
  String _selectedFood = '';
  NutritionResult? _nutritionResult;

  Future<void> _capturePhoto() async {
    final XFile? photo = await _picker.pickImage(source: ImageSource.camera);
    if (photo == null) {
      return;
    }

    setState(() {
      _imageFile = File(photo.path);
      _isLoading = true;
      _nutritionResult = null;
    });

    final quickMatches = _nutritionService.getQuickSuggestions();

    setState(() {
      _suggestedFoods = quickMatches;
      _selectedFood = quickMatches.first;
      _isLoading = false;
    });

    await _analyzeFood(_selectedFood);
  }

  Future<void> _analyzeFood(String foodName) async {
    setState(() {
      _isLoading = true;
    });

    final result = await _nutritionService.getNutrition(foodName);

    setState(() {
      _nutritionResult = result;
      _isLoading = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Nutrition Scanner'),
        centerTitle: true,
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              if (_imageFile != null)
                ClipRRect(
                  borderRadius: BorderRadius.circular(18),
                  child: Image.file(
                    _imageFile!,
                    height: 260,
                    fit: BoxFit.cover,
                  ),
                )
              else
                Container(
                  height: 260,
                  decoration: BoxDecoration(
                    color: Colors.green.shade50,
                    borderRadius: BorderRadius.circular(18),
                    border: Border.all(color: Colors.green.shade200),
                  ),
                  child: const Center(
                    child: Text(
                      'Captured food image will appear here',
                      style: TextStyle(fontSize: 16, color: Colors.green),
                    ),
                  ),
                ),
              const SizedBox(height: 20),
              FilledButton.icon(
                onPressed: _isLoading ? null : _capturePhoto,
                icon: const Icon(Icons.camera_alt_outlined),
                label: Text(_isLoading ? 'Analyzing...' : 'Take Photo'),
                style: FilledButton.styleFrom(
                  minimumSize: const Size.fromHeight(52),
                ),
              ),
              const SizedBox(height: 24),
              if (_suggestedFoods.isNotEmpty)
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Quick suggestions',
                      style: TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 10),
                    Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: _suggestedFoods.map((food) {
                        final isSelected = food == _selectedFood;
                        return ChoiceChip(
                          label: Text(food),
                          selected: isSelected,
                          onSelected: (_) {
                            setState(() => _selectedFood = food);
                            _analyzeFood(food);
                          },
                        );
                      }).toList(),
                    ),
                  ],
                ),
              const SizedBox(height: 24),
              if (_nutritionResult != null)
                Card(
                  elevation: 3,
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(18),
                  ),
                  child: Padding(
                    padding: const EdgeInsets.all(20),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Expanded(
                              child: Text(
                                _nutritionResult!.name,
                                style: const TextStyle(
                                  fontSize: 22,
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                            ),
                            Container(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 10,
                                vertical: 6,
                              ),
                              decoration: BoxDecoration(
                                color: Colors.green.shade100,
                                borderRadius: BorderRadius.circular(999),
                              ),
                              child: Text(
                                _nutritionResult!.servingSize,
                                style: const TextStyle(color: Colors.green),
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 18),
                        _NutritionRow('Calories', _nutritionResult!.calories),
                        _NutritionRow('Protein', _nutritionResult!.protein),
                        _NutritionRow('Carbs', _nutritionResult!.carbs),
                        _NutritionRow('Fat', _nutritionResult!.fat),
                        _NutritionRow('Fiber', _nutritionResult!.fiber),
                        _NutritionRow('Sugar', _nutritionResult!.sugar),
                        _NutritionRow('Sodium', _nutritionResult!.sodium),
                      ],
                    ),
                  ),
                )
              else if (_imageFile != null)
                const Padding(
                  padding: EdgeInsets.only(top: 12),
                  child: Text(
                    'Select a food suggestion to view nutrition details.',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 15, color: Colors.black54),
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }
}

class _NutritionRow extends StatelessWidget {
  const _NutritionRow(this.label, this.value);

  final String label;
  final String value;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(fontSize: 16)),
          Text(value, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
        ],
      ),
    );
  }
}
